# ==== MinIO / Object store ====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Endpoint để pipeline (chạy trên host) nói chuyện với MinIO trong Docker
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Bucket + tiền tố cho tầng Bronze
LAKEHOUSE_BUCKET=lakehouse
BRONZE_PREFIX=bronze

# ==== Hive Metastore (backing store cho Trino catalog) ====
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hive

# ==== Trino (query engine) ====
TRINO_HOST=localhost
TRINO_PORT=8080

# ==== Airflow ====
# UID chạy container Airflow, khớp user host để tránh lỗi quyền file log/dags.
# macOS: để mặc định 50000 là được. Linux: `id -u` rồi thay vào đây.
AIRFLOW_UID=50000

# ==== vnstock ====
# Nguồn dữ liệu: KBS (mặc định, ổn định nhất trên v4), hoặc VCI
VNSTOCK_SOURCE=KBS
# API key vnstock (tùy chọn) — đăng ký free tại https://vnstocks.com/login
# Guest 20 req/phut; Community 60 req/phut. Để trống nếu dùng chế độ khách.
VNSTOCK_API_KEY=

# Giãn cách giữa các request (giây) để tránh chạm rate limit
INGEST_SLEEP_SECONDS=3

# ==== RANH GIỚI DATA — chuẩn bị cho phase sau ====
# Ranh giới local-only vs. được-ra-API. Bronze layer thuần local, chưa cần.
# Khi tới RAG/LLM: chỉ field nào KHONG nhay cam moi duoc gui ra API.
ALLOW_EXTERNAL_API=false
